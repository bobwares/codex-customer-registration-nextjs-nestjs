# Exports: Environment variable examples
# Description: Example environment configuration for running the Customer Registration API locally.

# Application
APP_NAME=backend
NODE_ENV=development
PORT=3000

# Database (example: Postgres)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=appdb
DATABASE_SCHEMA=public
DATABASE_SSL=false

# Logging
LOG_LEVEL=log
LOG_FORMAT=json
